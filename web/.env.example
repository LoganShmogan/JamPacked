# Website settings (Next.js reads .env.local). Copy to .env.local; never commit real values.

# The Convex backend the owner dashboard (/admin) calls. Without it the site talks to production.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# PostHog page views, memory only (components/Analytics.tsx). Off while unset.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# Clerk, once set up (docs/issues/clerk-authentication.md). Not used yet.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...

# Stripe needs nothing here: the Buy buttons are Payment Links in src/lib/site.ts.
